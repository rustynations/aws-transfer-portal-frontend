# AWS Transfer Portal - Environment Configuration
# Copy this file to .env.local and update with your CDK deployment outputs:
#   cp .env.example .env.local

# API Gateway endpoint URL (from TransferPortalBackendStack outputs)
VITE_API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool ID (from TransferPortalBackendStack outputs)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito User Pool Client ID (from TransferPortalBackendStack outputs)
VITE_USER_POOL_CLIENT_ID=your-client-id

# AWS Region
VITE_AWS_REGION=us-east-1

# Transfer Family server endpoint (omit or leave empty if SFTP is disabled)
# VITE_TRANSFER_ENDPOINT=s-xxxxxxxxxxxx.server.transfer.us-east-1.amazonaws.com
