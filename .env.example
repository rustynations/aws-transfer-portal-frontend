# AWS Transfer Portal Configuration
# Copy this file to .env.local and update with your values from CDK deployment outputs

# API Gateway endpoint (from CDK output: ApiEndpoint)
VITE_API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool ID (from CDK output: UserPoolId)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito User Pool Client ID (from CDK output: UserPoolClientId)
VITE_USER_POOL_CLIENT_ID=your-client-id-here

# AWS Region
VITE_AWS_REGION=us-east-1

# Transfer Family endpoint (from CDK output: TransferServerEndpoint)
VITE_TRANSFER_ENDPOINT=s-xxxxxxxxxxxx.server.transfer.us-east-1.amazonaws.com
